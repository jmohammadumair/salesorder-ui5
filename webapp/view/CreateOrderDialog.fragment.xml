<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">
    
    <Dialog 
        id="createOrderDialog" 
        stretch="false" 
        contentWidth="620px" 
        class="customCreateDialog">
        
        <customHeader>
            <Bar class="customDialogHeader">
                <contentLeft>
                    <VBox class="sapUiTinyMarginBegin sapUiTinyMarginTopBottom">
                        <Title text="Create Sales Order: Initial Step" titleStyle="H4" class="customHeaderTitle" />
                        <Text text="VA01 Screen Flow — Section 4 Configuration" class="customHeaderSubtitle" />
                    </VBox>
                </contentLeft>
                <contentRight>
                    <Button icon="sap-icon://decline" type="Transparent" press=".onCloseCreateDialog" class="customHeaderCloseBtn" />
                </contentRight>
            </Bar>
        </customHeader>
        
        <content>
            <VBox class="sapUiMediumMargin">
                <l:Grid defaultSpan="XL6 L6 M6 S12" vSpacing="0" hSpacing="1">
                    <!-- Column 1 Row 1: Order Type -->
                    <VBox class="formFieldBox">
                        <Label text="SALES ORDER TYPE" class="formFieldLabel" />
                        <Input 
                            value="{/initialDialogData/orderType}" 
                            showValueHelp="true"
                            valueHelpRequest=".onOrderTypeHelp"
                            change=".onOrderTypeChange"
                            class="formFieldInput" />
                        <Text text="{/initialDialogData/orderTypeDesc}" class="formFieldDesc" />
                    </VBox>

                    <!-- Column 2 Row 1: Sales Organization -->
                    <VBox class="formFieldBox">
                        <Label text="SALES ORGANIZATION" class="formFieldLabel" />
                        <Input 
                            value="{/initialDialogData/salesOrg}" 
                            showValueHelp="true"
                            valueHelpRequest=".onSalesOrgHelp"
                            change=".onSalesOrgChange"
                            class="formFieldInput" />
                        <Text text="{/initialDialogData/salesOrgDesc}" class="formFieldDesc" />
                    </VBox>

                    <!-- Column 1 Row 2: Distribution Channel -->
                    <VBox class="formFieldBox">
                        <Label text="DISTRIBUTION CHANNEL" class="formFieldLabel" />
                        <Input 
                            value="{/initialDialogData/distChannel}" 
                            showValueHelp="true"
                            valueHelpRequest=".onDistChannelHelp"
                            change=".onDistChannelChange"
                            class="formFieldInput" />
                        <Text text="{/initialDialogData/distChannelDesc}" class="formFieldDesc" />
                    </VBox>

                    <!-- Column 2 Row 2: Division -->
                    <VBox class="formFieldBox">
                        <Label text="DIVISION" class="formFieldLabel" />
                        <Input 
                            value="{/initialDialogData/division}" 
                            showValueHelp="true"
                            valueHelpRequest=".onDivisionHelp"
                            change=".onDivisionChange"
                            class="formFieldInput" />
                        <Text text="{/initialDialogData/divisionDesc}" class="formFieldDesc" />
                    </VBox>

                    <!-- Row 3: Sold-To Customer Party (KUNNR) - Full width -->
                    <VBox class="formFieldBox">
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                        <Label text="SOLD-TO CUSTOMER PARTY (KUNNR)" class="formFieldLabel" />
                        <Input 
                            value="{/initialDialogData/soldToParty}" 
                            showValueHelp="true"
                            valueHelpRequest=".onSoldToPartyHelp"
                            change=".onSoldToPartyChange"
                            class="formFieldInput" />
                        <Text text="{/initialDialogData/soldToPartyDesc}" class="formFieldDesc" />
                    </VBox>
                </l:Grid>
            </VBox>
        </content>
        
        <buttons>
            <Button text="Cancel" press=".onCloseCreateDialog" class="customCancelBtn" />
            <Button text="Continue to Overview" press=".onContinueCreateOrder" type="Emphasized" class="customContinueBtn" />
        </buttons>
        
    </Dialog>
</core:FragmentDefinition>
