<mvc:View
    controllerName="salesorder.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <SplitApp id="splitApp" initialDetail="detailPage" initialMaster="masterPage">
            
            <!-- ================== MASTER VIEW PANE (Left) ================== -->
            <masterPages>
                <Page id="masterPage" title="VA05 Sales Orders" class="sapUiStdPage">
                    <headerContent>
                        <Button icon="sap-icon://add" press=".onCreateOrder" type="Emphasized" tooltip="VA01 Create" text="Create" />
                    </headerContent>
                    <subHeader>
                        <Toolbar>
                            <SearchField liveChange=".onSearch" width="100%" placeholder="Search Orders, Customers, PO..." />
                        </Toolbar>
                    </subHeader>
                    <content>
                        <List 
                            id="orderList" 
                            items="{
                                path: '/SalesOrders',
                                parameters: {
                                    $expand: 'items,partners,scheduleLines,pricingConditions'
                                }
                            }" 
                            mode="SingleSelectMaster" 
                            selectionChange=".onOrderSelect">
                            <items>
                                <ObjectListItem
                                    title="Order #{salesOrder}"
                                    number="{
                                        parts: [{path: 'netValue'}],
                                        type: 'sap.ui.model.type.Float',
                                        formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}
                                    }"
                                    numberUnit="$"
                                    type="Active">
                                    <firstStatus>
                                        <ObjectStatus text="{status}" state="{= ${status} === 'Active Version' ? 'Success' : 'Warning' }" />
                                    </firstStatus>
                                    <attributes>
                                        <ObjectAttribute text="{soldToParty}" />
                                        <ObjectAttribute text="{docDate}" />
                                    </attributes>
                                </ObjectListItem>
                            </items>
                        </List>
                    </content>
                </Page>
            </masterPages>

            <!-- ================== DETAIL VIEW PANE (Right) ================== -->
            <detailPages>
                <Page 
                    id="detailPage" 
                    title="Manage Sales Orders (VA01 / VA05)"
                    showNavButton="{device>/system/phone}"
                    navButtonPress=".onNavBack">
                    <headerContent>
                        <Button 
                            text="{= ${ui>/simulatedLockUser} ? 'Simulate Lock: ACTIVE' : 'Simulate Lock: INACTIVE' }" 
                            type="{= ${ui>/simulatedLockUser} ? 'Reject' : 'Default' }"
                            icon="{= ${ui>/simulatedLockUser} ? 'sap-icon://locked' : 'sap-icon://unlocked' }" 
                            press=".onToggleLock" />
                    </headerContent>
                    <content>
                        
                        <!-- Empty State View -->
                        <VBox visible="{= !${ui>/activeOrder} }" alignItems="Center" justifyContent="Center" height="100%" class="sapUiMediumMarginTop">
                            <core:Icon src="sap-icon://sales-document" size="4rem" color="#cccccc" class="sapUiMediumMarginBottom"/>
                            <Title text="No Sales Document Selected" level="H3" class="sapUiSmallMarginBottom" />
                            <Text text="Select an order record from the Master list pane or trigger standard creation to initiate transaction mapping." />
                            <Button text="Launch VA01 Screen" press=".onCreateOrder" type="Emphasized" class="sapUiMediumMarginTop" />
                        </VBox>

                        <!-- Main Detail Content (Only when an order is active/selected) -->
                        <VBox visible="{= !!${ui>/activeOrder} }" class="sapUiContentPadding">
                            
                            <!-- Dynamic Object Header Card -->
                            <ObjectHeader
                                title="Standard Order: {ui>/draftModel/salesOrder}"
                                number="{
                                    parts: [{path: '/draftModel/netValue'}],
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}
                                }"
                                numberUnit="USD"
                                responsive="true">
                                <statuses>
                                    <ObjectStatus text="{ui>/draftModel/status}" state="{= ${ui>/draftModel/status} === 'Active Version' ? 'Success' : 'Warning' }" />
                                    <ObjectStatus 
                                        text="{= ${ui>/isEditing} ? 'Draft: ' + ${ui>/draftIndicator} : 'Display Mode' }" 
                                        state="{= ${ui>/isEditing} ? 'Warning' : 'None' }" />
                                </statuses>
                                <attributes>
                                    <ObjectAttribute title="Sold-To" text="{ui>/draftModel/soldToParty}" />
                                    <ObjectAttribute title="PO Ref" text="{ui>/draftModel/poNumber}" />
                                    <ObjectAttribute title="Delivering Plant / Dock" text="{ui>/draftModel/shippingPoint}" />
                                </attributes>
                            </ObjectHeader>

                            <!-- KPI Cards Block -->
                            <HBox wrap="Wrap" justifyContent="Start" width="100%" class="sapUiSmallMarginBottom">
                                <VBox style="flex:1; min-width:320px;" class="sapUiSmallMarginBottom">
                                    <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                                        <!-- Card 1: Credit Limit Progress -->
                                        <VBox class="sapUiTinyMargin sapUiContentPadding bg-card" width="220px" style="border: 1px solid #e0e0e0; border-radius: 8px; background-color: #fcfcfc;">
                                            <Label text="Credit Limit Check" design="Bold" />
                                            <Text text="{ui>/creditLimitText}" class="sapUiTinyMarginTop" />
                                            <ProgressIndicator 
                                                percentValue="{ui>/creditPercent}" 
                                                displayValue="{ui>/creditPercent}%" 
                                                state="{= ${ui>/creditPercent} > 80 ? 'Error' : 'Success' }" 
                                                class="sapUiTinyMarginTop" />
                                        </VBox>

                                        <!-- Card 2: YTD Sales Volume -->
                                        <VBox class="sapUiTinyMargin sapUiContentPadding bg-card" width="220px" style="border: 1px solid #e0e0e0; border-radius: 8px; background-color: #fcfcfc;">
                                            <Label text="YTD Sales Vol." design="Bold" />
                                            <ObjectNumber
                                                number="{ui>/creditYtdSales}"
                                                numberUnit="USD"
                                                class="sapUiTinyMarginTop font-bold" />
                                            <Text text="Accumulated current fiscal" style="font-size: 10px; color: #777;" class="sapUiTinyMarginTop" />
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </HBox>

                            <!-- ANCHOR-BAR TABS NAVIGATION SYSTEM -->
                            <IconTabBar id="idIconTabBar" class="sapUiResponsiveContentPadding" headerMode="Inline">
                                <items>
                                    
                                    <!-- TAB 1: General Info -->
                                    <IconTabFilter text="General Info" key="general">
                                        <f:SimpleForm editable="{ui>/isEditing}" layout="ColumnLayout" title="Header Details">
                                            <f:content>
                                                <Label text="Sales Document Type" />
                                                <Input value="{ui>/draftModel/orderType}" editable="false" />
                                                
                                                <Label text="Sales Organization" />
                                                <Input value="{ui>/draftModel/generalInfo/salesOrg}" editable="false" />
                                                
                                                <Label text="Distribution Channel" />
                                                <Input value="{ui>/draftModel/generalInfo/distChannel}" editable="false" />
                                                
                                                <Label text="Division" />
                                                <Input value="{ui>/draftModel/generalInfo/division}" editable="false" />

                                                <Label text="Sold-to Party (KUNNR)" />
                                                <Input 
                                                    value="{ui>/draftModel/soldToParty}" 
                                                    editable="{ui>/isEditing}" 
                                                    showValueHelp="true" 
                                                    valueHelpRequest=".onSoldToHelp" 
                                                    change=".onHeaderChange" />
                                                    
                                                <Label text="Ship-to Party (WE)" />
                                                <Input 
                                                    value="{ui>/draftModel/generalInfo/shipToParty}" 
                                                    editable="{ui>/isEditing}" 
                                                    showValueHelp="true" 
                                                    valueHelpRequest=".onShipToHelp" 
                                                    change=".onHeaderChange" />

                                                <Label text="PO Number" />
                                                <Input value="{ui>/draftModel/poNumber}" editable="{ui>/isEditing}" />

                                                <Label text="PO Date" />
                                                <DatePicker value="{ui>/draftModel/generalInfo/poDate}" valueFormat="yyyy-MM-dd" editable="{ui>/isEditing}" />

                                                <Label text="Document Date" />
                                                <DatePicker value="{ui>/draftModel/docDate}" valueFormat="yyyy-MM-dd" editable="false" />

                                                <Label text="Req. Delivery Date" />
                                                <DatePicker value="{ui>/draftModel/generalInfo/reqDeliveryDate}" valueFormat="yyyy-MM-dd" editable="{ui>/isEditing}" change=".onHeaderChange" />
                                            </f:content>
                                        </f:SimpleForm>
                                    </IconTabFilter>

                                    <!-- TAB 2: Line Items -->
                                    <IconTabFilter text="Line Items" key="items">
                                        <Table id="itemsTable" items="{ui>/draftModel/items}">
                                            <headerToolbar>
                                                <OverflowToolbar>
                                                    <Title text="FACET 2: SALES ORDER ITEMS TABLE (VBAP AND VBKD)" level="H2"/>
                                                    <ToolbarSpacer />
                                                    <Button icon="sap-icon://add" text="Add Row" press=".onAddItem" visible="{ui>/isEditing}" />
                                                </OverflowToolbar>
                                            </headerToolbar>
                                            <columns>
                                                <Column width="4rem"><Text text="ITEM" /></Column>
                                                <Column width="8rem"><Text text="MATERIAL" /></Column>
                                                <Column><Text text="DESCRIPTION" /></Column>
                                                <Column width="6rem"><Text text="QUANTITY" /></Column>
                                                <Column width="5rem"><Text text="UOM" /></Column>
                                                <Column width="10rem"><Text text="CATEGORY" /></Column>
                                                <Column width="7rem" hAlign="Right"><Text text="NET VALUE" /></Column>
                                                <Column width="9rem" hAlign="Center"><Text text="DELIVERING PLANT" /></Column>
                                                <Column width="8rem" hAlign="Center"><Text text="SELECT" /></Column>
                                                <Column width="3rem" hAlign="Center" visible="{ui>/isEditing}"><Text text="" /></Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem>
                                                    <cells>
                                                        <Text text="{ui>itemNum}" />
                                                        <Input 
                                                            value="{ui>material}" 
                                                            editable="{ui>/isEditing}" 
                                                            showValueHelp="true" 
                                                            valueHelpRequest=".onMaterialHelp" 
                                                            change=".onItemChange" />
                                                        <Text text="{ui>desc}" />
                                                        <Input value="{ui>qty}" type="Number" editable="{ui>/isEditing}" change=".onItemChange" />
                                                        <Text text="{ui>uom}" />
                                                        <Text text="{ui>itemCategory}" />
                                                        <ObjectNumber number="{ui>netValue}" numberUnit="USD" />
                                                        <Input 
                                                            value="{ui>plant}" 
                                                            editable="{ui>/isEditing}" 
                                                            showValueHelp="true" 
                                                            valueHelpRequest=".onPlantHelp" 
                                                            change=".onItemChange" />
                                                        <Button text="CONDITIONS" type="Emphasized" press=".onSelectConditions" />
                                                        <Button icon="sap-icon://delete" type="Reject" press=".onDeleteItem" />
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </IconTabFilter>

                                    <!-- TAB 3: Partner Functions -->
                                    <IconTabFilter text="Partner Functions" key="partners">
                                        <Table items="{ui>/draftModel/partners}">
                                            <columns>
                                                <Column width="5rem"><Text text="Role" /></Column>
                                                <Column width="10rem"><Text text="Description" /></Column>
                                                <Column width="8rem"><Text text="Partner ID" /></Column>
                                                <Column width="12rem"><Text text="Name" /></Column>
                                                <Column><Text text="Address" /></Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem>
                                                    <cells>
                                                        <Text text="{ui>role}" />
                                                        <Text text="{ui>desc}" />
                                                        <Text text="{ui>partnerId}" />
                                                        <Text text="{ui>name}" />
                                                        <Text text="{ui>address}" />
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </IconTabFilter>

                                    <!-- TAB 4: Pricing Conditions -->
                                    <IconTabFilter text="Pricing Conditions" key="pricing">
                                        <VBox spacing="6px">
                                            <HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                                                <Label text="Select Pricing Item:" class="sapUiTinyMarginEnd" design="Bold" />
                                                <Select 
                                                    id="pricingItemSelect" 
                                                    items="{ui>/draftModel/items}" 
                                                    selectedKey="{ui>/selectedLineItemIndex}"
                                                    change=".onPricingItemChange">
                                                    <core:Item key="{= ${ui>itemNum} - 10 }" text="Item {ui>itemNum} - {ui>material} ({ui>desc})" />
                                                </Select>
                                            </HBox>

                                            <!-- Manual Pricing Conditions Override Fields (Only when editing) -->
                                            <f:SimpleForm editable="true" layout="ColumnLayout" title="Manual Overrides for Selected Item" visible="{ui>/isEditing}">
                                                <f:content>
                                                    <Label text="Base Price (PR00)" />
                                                    <Input 
                                                        value="{ui>/manualPrice}" 
                                                        type="Number" 
                                                        placeholder="Override Base Price..."
                                                        change=".onPricingOverrideChange" />
                                                    
                                                    <Label text="Customer Discount (K007 %)" />
                                                    <Input 
                                                        value="{ui>/manualDiscount}" 
                                                        type="Number" 
                                                        placeholder="Override Discount %..."
                                                        change=".onPricingOverrideChange" />

                                                    <Label text="Freight Surcharge (KF00)" />
                                                    <Input 
                                                        value="{ui>/manualFreight}" 
                                                        type="Number" 
                                                        placeholder="Override Freight..."
                                                        change=".onPricingOverrideChange" />
                                                </f:content>
                                            </f:SimpleForm>

                                            <Table items="{ui>/selectedItemConditions}">
                                                <headerToolbar>
                                                    <OverflowToolbar>
                                                        <Title text="RVAA01 Pricing Procedure Logic" level="H2"/>
                                                    </OverflowToolbar>
                                                </headerToolbar>
                                                <columns>
                                                    <Column width="4rem"><Text text="Step" /></Column>
                                                    <Column width="6rem"><Text text="Cond. Type" /></Column>
                                                    <Column><Text text="Description" /></Column>
                                                    <Column width="8rem" hAlign="Right"><Text text="Rate" /></Column>
                                                    <Column width="8rem" hAlign="Right"><Text text="Base Value" /></Column>
                                                    <Column width="8rem" hAlign="Right"><Text text="Calculated Value" /></Column>
                                                </columns>
                                                <items>
                                                    <ColumnListItem>
                                                        <cells>
                                                            <Text text="{ui>step}" />
                                                            <Text text="{ui>type}" />
                                                            <Text text="{ui>desc}" />
                                                            <Text text="{ui>rate}" />
                                                            <Text text="{ui>base}" />
                                                            <ObjectNumber number="{ui>val}" numberUnit="USD" />
                                                        </cells>
                                                    </ColumnListItem>
                                                </items>
                                            </Table>
                                        </VBox>
                                    </IconTabFilter>

                                    <!-- TAB 5: Schedule Lines (ATP split engine) -->
                                    <IconTabFilter text="Schedule Lines" key="schedule">
                                        <Table items="{ui>/draftModel/scheduleLines}">
                                            <headerToolbar>
                                                <Toolbar height="auto">
                                                    <VBox class="sapUiSmallMarginTopBottom sapUiSmallMarginBegin">
                                                        <Title text="FACET 5: DELIVERY SCHEDULE LINES &amp; ATP AVAILABILITY (VBEP)" level="H2" class="sapUiTinyMarginBottom" />
                                                        <Text text="Stock availability splits quantities intelligently to safeguard logistics commitments." />
                                                    </VBox>
                                                </Toolbar>
                                            </headerToolbar>
                                            <columns>
                                                <Column width="6rem" hAlign="Center"><Text text="LINE ITEM" /></Column>
                                                <Column width="8rem" hAlign="Center"><Text text="SCHEDULE NO." /></Column>
                                                <Column width="10rem" hAlign="Center"><Text text="CATEGORY" /></Column>
                                                <Column width="12rem" hAlign="Center"><Text text="PLANNED DELIVERY DATE" /></Column>
                                                <Column width="8rem" hAlign="Center"><Text text="ORDERED QTY" /></Column>
                                                <Column width="12rem" hAlign="Center"><Text text="ATP CONFIRMED QTY" /></Column>
                                                <Column width="10rem" hAlign="Center"><Text text="MOVEMENT TYPE" /></Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem>
                                                    <cells>
                                                        <Text text="{ui>itemNum}" />
                                                        <Link text="{ui>line}" />
                                                        <ObjectStatus text="{ui>cat}" state="Information" />
                                                        <Text text="{ui>date}" style="font-weight: bold;" />
                                                        <Text text="{ui>orderQty}" style="font-weight: bold;" />
                                                        <Text text="{ui>confQty}" style="font-weight: bold; color: green;" />
                                                        <Text text="{ui>movType}" />
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </IconTabFilter>

                                    <!-- TAB 6: Shipping & Route -->
                                    <IconTabFilter text="Shipping &amp; Route" key="shipping">
                                        <f:SimpleForm editable="{ui>/isEditing}" layout="ColumnLayout" title="Logistics &amp; Shipping Determinators">
                                            <f:content>
                                                <Label text="Shipping Conditions" />
                                                <Select 
                                                    selectedKey="{ui>/draftModel/shippingRoute/shippingConditions}" 
                                                    enabled="{ui>/isEditing}" 
                                                    change=".onHeaderChange" 
                                                    >
                                                    <core:Item key="{key}" text="{key} - {ui>desc}" />
                                                </Select>

                                                <Label text="Shipping Point (Delivering Dock)" />
                                                <Input value="{ui>/draftModel/shippingPoint}" editable="false" />

                                                <Label text="Route" />
                                                <Input value="{ui>/draftModel/shippingRoute/route}" editable="false" />
                                            </f:content>
                                        </f:SimpleForm>
                                    </IconTabFilter>

                                    <!-- TAB 7: Billing & Financial -->
                                    <IconTabFilter text="Billing &amp; Financial" key="billing">
                                        <f:SimpleForm editable="{ui>/isEditing}" layout="ColumnLayout" title="Billing Blocks &amp; Financial Parameters">
                                            <f:content>
                                                <Label text="Payment Terms" />
                                                <Select 
                                                    selectedKey="{ui>/draftModel/billingFinancial/paymentTerms}" 
                                                    enabled="{ui>/isEditing}" 
                                                    >
                                                    <core:Item key="{key}" text="{key} - {ui>desc}" />
                                                </Select>

                                                <Label text="Incoterms Part 1" />
                                                <Select 
                                                    selectedKey="{ui>/draftModel/billingFinancial/incotermsPart1}" 
                                                    enabled="{ui>/isEditing}" 
                                                    >
                                                    <core:Item key="{key}" text="{key} - {ui>desc}" />
                                                </Select>

                                                <Label text="Incoterms Part 2 (Location)" />
                                                <Input value="{ui>/draftModel/billingFinancial/incotermsPart2}" editable="{ui>/isEditing}" />

                                                <Label text="Billing Block (Active Check)" />
                                                <Select 
                                                    selectedKey="{ui>/draftModel/billingFinancial/billingBlock}" 
                                                    enabled="{ui>/isEditing}" 
                                                    >
                                                    <core:Item key="{key}" text="{key} - {ui>desc}" />
                                                </Select>

                                                <Label text="Delivery Block" />
                                                <Select 
                                                    selectedKey="{ui>/draftModel/billingFinancial/deliveryBlock}" 
                                                    enabled="{ui>/isEditing}" 
                                                    >
                                                    <core:Item key="{key}" text="{key} - {ui>desc}" />
                                                </Select>
                                            </f:content>
                                        </f:SimpleForm>
                                    </IconTabFilter>

                                </items>
                            </IconTabBar>

                            <!-- VBFA Document Flow Panel (fixed below tabs) -->
                            <VBox class="vbfaContainer sapUiSmallMarginTop">
                                <HBox class="vbfaHeaderContainer" justifyContent="SpaceBetween" alignItems="Center">
                                    <HBox class="vbfaHeaderTitleRow" alignItems="Center">
                                        <core:Icon src="sap-icon://open-command-field" class="vbfaHeaderIcon" />
                                        <Text text="VBFA Document Flow Process" class="vbfaHeader" />
                                    </HBox>
                                    <Button text="Trace Keys" type="Transparent" class="vbfaTraceButton" />
                                </HBox>

                                <HBox class="vbfaContentContainer">
                                    <HBox class="vbfaStepCard" alignItems="Center" justifyContent="SpaceBetween">
                                        <VBox class="vbfaTextContainer" alignItems="Start">
                                            <Text text="STANDARD ORDER" class="vbfaTitle" />
                                            <Text text="{= 'SO #' + ${ui>/draftModel/salesOrder}}" class="vbfaSubtitle" />
                                        </VBox>
                                        <core:Icon src="sap-icon://sys-enter-2" class="vbfaSuccessIcon" size="1.25rem" />
                                    </HBox>

                                    <HBox class="vbfaArrowContainer" alignItems="Center" justifyContent="Center">
                                        <core:Icon src="sap-icon://navigation-right-arrow" class="vbfaArrow" size="0.75rem" />
                                    </HBox>

                                    <HBox class="vbfaStepCard" alignItems="Center" justifyContent="SpaceBetween">
                                        <VBox class="vbfaTextContainer" alignItems="Start">
                                            <Text text="OUTBOUND DELIVERY" class="vbfaTitle" />
                                            <Text text="DLV #80001294" class="vbfaSubtitle" />
                                        </VBox>
                                        <core:Icon src="sap-icon://sys-enter-2" class="vbfaSuccessIcon" size="1.25rem" />
                                    </HBox>

                                    <HBox class="vbfaArrowContainer" alignItems="Center" justifyContent="Center">
                                        <core:Icon src="sap-icon://navigation-right-arrow" class="vbfaArrow" size="0.75rem" />
                                    </HBox>

                                    <HBox class="vbfaStepCard" alignItems="Center" justifyContent="SpaceBetween">
                                        <VBox class="vbfaTextContainer" alignItems="Start">
                                            <Text text="BILLING DOCUMENT" class="vbfaTitle" />
                                            <Text text="INV #90042851" class="vbfaSubtitle" />
                                        </VBox>
                                        <core:Icon src="sap-icon://sys-enter-2" class="vbfaSuccessIcon" size="1.25rem" />
                                    </HBox>

                                    <HBox class="vbfaArrowContainer" alignItems="Center" justifyContent="Center">
                                        <core:Icon src="sap-icon://navigation-right-arrow" class="vbfaArrow" size="0.75rem" />
                                    </HBox>

                                    <HBox class="vbfaStepCard" alignItems="Center" justifyContent="SpaceBetween">
                                        <VBox class="vbfaTextContainer" alignItems="Start">
                                            <Text text="UNIVERSAL JOURNAL GL" class="vbfaTitle" />
                                            <Text text="ACDOCA #1000293" class="vbfaSubtitle" />
                                        </VBox>
                                        <core:Icon src="sap-icon://sys-enter-2" class="vbfaSuccessIcon" size="1.25rem" />
                                    </HBox>
                                </HBox>
                            </VBox>
                        </VBox>
                    </content>
                    <footer>
                        <OverflowToolbar visible="{= !!${ui>/activeOrder} }">
                            <Button icon="sap-icon://message-popup" text="Message Log" type="Transparent" press=".onShowMessageLog" />
                            <ToolbarSpacer />
                            <Button text="Discard Draft" press=".onDiscardDraft" visible="{ui>/isEditing}" type="Transparent" />
                            <Button text="Save Order" press=".onSaveOrder" visible="{ui>/isEditing}" type="Emphasized" />
                            <Button text="Delete Order" press=".onDeleteOrder" visible="{= !${ui>/isEditing} }" type="Reject" />
                            <Button text="Edit Order" press=".onEditOrder" visible="{= !${ui>/isEditing} }" type="Emphasized" />
                        </OverflowToolbar>
                    </footer>
                </Page>
            </detailPages>
        </SplitApp>
</mvc:View>

