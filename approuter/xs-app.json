{
  "welcomeFile": "/salesorder/index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/sap/(.*)$",
      "target": "/sap/$1",
      "destination": "SS4_DEV",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/sales-order/(.*)$",
      "target": "/sales-order/$1",
      "destination": "salesorder-capm-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "none"
    }
  ]
}
